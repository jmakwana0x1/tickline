# Copy to .env. Never commit .env; gitleaks and push protection both watch for it.

# Postgres (docker-compose.yml maps 5433 to avoid clashing with a local 5432)
DATABASE_URL=postgres://tickline:tickline@localhost:5433/tickline

# Local chain
ANVIL_PORT=8545
RPC_URL=http://localhost:8545
CHAIN_ID=31337

# Engine. In dev this is anvil's first test account; NEVER a funded key.
OPERATOR_SIGNING_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
OPERATOR_BOND_USDC=1000000000

# Test knobs
PROPTEST_CASES=256
FOUNDRY_PROFILE=default

# Phase 8 only
BASE_SEPOLIA_RPC_URL=
ETHERSCAN_API_KEY=
